{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/rpg-system",
    "title": "RPG system",
    "description": "Sistema de juego de rol (una edición concreta de un juego) de la sección de otros juegos de rol",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "slug",
        "name",
        "family",
        "publisher",
        "date",
        "description",
        "features",
        "licenses",
        "links"
    ],
    "properties": {
        "slug": {
            "$ref": "#/$defs/slug"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "family": {
            "description": "Agrupa las ediciones del mismo juego (pathfinder, dungeons-and-dragons…)",
            "$ref": "#/$defs/slug"
        },
        "publisher": {
            "type": "string",
            "minLength": 1
        },
        "date": {
            "$ref": "#/$defs/partialDate"
        },
        "description": {
            "description": "Descripción propia en castellano: qué es y cómo se juega",
            "type": "string",
            "minLength": 1
        },
        "features": {
            "description": "Características principales, cortas",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "licenses": {
            "description": "Licencias abiertas que usa, cada una desde qué versión o fecha; vacío si no tiene licencia abierta",
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "license"
                ],
                "properties": {
                    "license": {
                        "$ref": "#/$defs/slug"
                    },
                    "since": {
                        "description": "Fecha o versión desde la que la usa (por ejemplo, «Remaster»)",
                        "type": "string",
                        "minLength": 1
                    },
                    "note": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "derived_from": {
            "description": "Sistemas de los que deriva directamente",
            "type": "array",
            "items": {
                "$ref": "#/$defs/derivation"
            }
        },
        "official": {
            "description": "Edición oficial de D&D (de Wizards of the Coast). Sin official_catalog, tiene su sección en /ediciones",
            "type": "boolean"
        },
        "official_catalog": {
            "description": "Solo en los sistemas de D&D: ruta del catálogo oficial del sitio",
            "enum": [
                "/2014",
                "/2024"
            ]
        },
        "links": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/link"
            }
        }
    },
    "$defs": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "partialDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
        },
        "link": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "label",
                "url"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        },
        "derivation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "system",
                "kind"
            ],
            "properties": {
                "system": {
                    "$ref": "#/$defs/slug"
                },
                "kind": {
                    "description": "revision: revisión con cambios menores; compatible: reescrito, pero en general compatible; major_rewrite: cambio mayor de reglas; inspiration: inspiración, sin compatibilidad",
                    "enum": [
                        "revision",
                        "compatible",
                        "major_rewrite",
                        "inspiration"
                    ]
                },
                "via_license": {
                    "$ref": "#/$defs/slug"
                },
                "note": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "if": {
                "properties": {
                    "kind": {
                        "const": "inspiration"
                    }
                }
            },
            "then": {
                "required": [
                    "note"
                ]
            }
        }
    }
}
