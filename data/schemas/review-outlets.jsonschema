{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/review-outlets",
    "title": "ReviewOutlets",
    "description": "Medios aceptados para las reseñas de los libros: medios editoriales con redacción y firma cuyas reseñas analizan el libro y dan un veredicto.",
    "type": "array",
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
            "id",
            "name",
            "url",
            "language"
        ],
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
            },
            "name": {
                "type": "string"
            },
            "url": {
                "type": "string",
                "format": "uri"
            },
            "language": {
                "type": "string",
                "enum": ["english", "castellano"]
            },
            "scale": {
                "description": "Máximo de la nota (10, 5, 100). Sin escala, el medio no pone nota numérica.",
                "type": "number",
                "exclusiveMinimum": 0
            }
        }
    }
}
