{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/screen",
    "title": "ScreenWork",
    "description": "Película, serie, documental o episodio de D&D, oficial o no oficial",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "slug",
        "kind",
        "official",
        "title",
        "description",
        "status"
    ],
    "properties": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "kind": {
            "enum": [
                "film",
                "series",
                "documentary",
                "episode"
            ]
        },
        "official": {
            "type": "boolean"
        },
        "unofficial_reason": {
            "type": "string",
            "minLength": 1
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "title_es": {
            "type": "string",
            "minLength": 1
        },
        "parent_series": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "status": {
            "enum": [
                "released",
                "announced"
            ]
        },
        "series": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "start_year",
                "seasons"
            ],
            "properties": {
                "start_year": {
                    "type": "integer",
                    "minimum": 1970
                },
                "end_year": {
                    "type": "integer",
                    "minimum": 1970
                },
                "seasons": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "releases": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/release"
            }
        },
        "physical_editions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/physicalEdition"
            }
        },
        "posters": {
            "type": "array",
            "maxItems": 2,
            "items": {
                "$ref": "#/$defs/poster"
            }
        },
        "trailers": {
            "type": "array",
            "maxItems": 3,
            "items": {
                "$ref": "#/$defs/trailer"
            }
        },
        "external": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "imdb": {
                    "type": "string",
                    "pattern": "^https://www\\.imdb\\.com/title/tt\\d{7,8}/$"
                },
                "filmaffinity": {
                    "type": "string",
                    "pattern": "^https://www\\.filmaffinity\\.com/es/film\\d{6}\\.html$"
                },
                "wikidata": {
                    "type": "string",
                    "pattern": "^Q\\d+$"
                }
            }
        },
        "related_novels": {
            "$ref": "#/$defs/slugs"
        },
        "related_merchandise": {
            "$ref": "#/$defs/slugs"
        },
        "related_videogames": {
            "$ref": "#/$defs/slugs"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "official": {
                        "const": false
                    }
                }
            },
            "then": {
                "required": [
                    "unofficial_reason"
                ]
            },
            "else": {
                "not": {
                    "required": [
                        "unofficial_reason"
                    ]
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "episode"
                    }
                }
            },
            "then": {
                "required": [
                    "parent_series"
                ]
            },
            "else": {
                "not": {
                    "required": [
                        "parent_series"
                    ]
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "enum": [
                            "film",
                            "episode"
                        ]
                    }
                }
            },
            "then": {
                "not": {
                    "required": [
                        "series"
                    ]
                }
            }
        },
        {
            "if": {
                "properties": {
                    "kind": {
                        "const": "series"
                    },
                    "status": {
                        "const": "released"
                    }
                }
            },
            "then": {
                "required": [
                    "series"
                ]
            }
        }
    ],
    "$defs": {
        "date": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
        },
        "slugs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
        },
        "release": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "country",
                "medium",
                "date"
            ],
            "properties": {
                "country": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$"
                },
                "medium": {
                    "enum": [
                        "cinema",
                        "tv",
                        "streaming",
                        "home_video"
                    ]
                },
                "date": {
                    "$ref": "#/$defs/date"
                },
                "network": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "physicalEdition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "format",
                "spanish_audio",
                "spanish_subtitles"
            ],
            "properties": {
                "format": {
                    "enum": [
                        "dvd",
                        "bluray",
                        "uhd"
                    ]
                },
                "year": {
                    "type": "integer",
                    "minimum": 1980
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "spanish_audio": {
                    "type": "boolean"
                },
                "spanish_subtitles": {
                    "type": "boolean"
                },
                "purchase_links": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "store",
                            "url"
                        ],
                        "properties": {
                            "store": {
                                "enum": [
                                    "amazon"
                                ]
                            },
                            "url": {
                                "type": "string",
                                "format": "uri"
                            }
                        }
                    }
                }
            }
        },
        "poster": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "language",
                "image",
                "source"
            ],
            "properties": {
                "language": {
                    "enum": [
                        "en",
                        "es",
                        "pt"
                    ]
                },
                "image": {
                    "type": "string",
                    "pattern": "^/images/screen/[a-z0-9-]+/poster-[a-z]{2}\\.webp$"
                },
                "source": {
                    "type": "string",
                    "format": "uri"
                }
            }
        },
        "trailer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "youtube",
                "language",
                "title",
                "channel",
                "date"
            ],
            "properties": {
                "youtube": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{11}$"
                },
                "language": {
                    "enum": [
                        "en",
                        "es",
                        "pt"
                    ]
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "channel": {
                    "type": "string",
                    "minLength": 1
                },
                "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                }
            }
        }
    }
}
