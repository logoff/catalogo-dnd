{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "/schemas/comic",
  "title": "Comic",
  "description": "Una serie de cómics oficial de D&D (o una novela gráfica u obra única), con sus números y sus ediciones recopiladas en inglés y en castellano",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "publisher",
    "setting",
    "kind",
    "date",
    "issue_count",
    "description",
    "source",
    "issues"
  ],
  "properties": {
    "slug": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_es": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "description": "Idioma original de la serie: solo para las publicadas primero en castellano (por defecto, inglés)",
      "enum": [
        "castellano"
      ]
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "setting": {
      "$ref": "#/$defs/setting"
    },
    "kind": {
      "enum": [
        "ongoing",
        "limited_series",
        "one_shot",
        "graphic_novel",
        "promotional",
        "webcomic"
      ]
    },
    "date": {
      "$ref": "#/$defs/partialDate"
    },
    "end_date": {
      "$ref": "#/$defs/partialDate"
    },
    "announced": {
      "description": "Anunciada y todavía sin publicar entera: issue_count es el anunciado",
      "type": "boolean"
    },
    "issue_count": {
      "type": "integer",
      "minimum": 1
    },
    "writers": {
      "$ref": "#/$defs/people"
    },
    "artists": {
      "$ref": "#/$defs/people"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "editions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edition"
      }
    },
    "continues": {
      "$ref": "#/$defs/slug"
    },
    "related_novels": {
      "$ref": "#/$defs/slugs"
    },
    "related_videogames": {
      "$ref": "#/$defs/slugs"
    },
    "related_merchandise": {
      "$ref": "#/$defs/slugs"
    },
    "related_products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edition",
          "code"
        ],
        "properties": {
          "edition": {
            "enum": [
              "5e",
              "2024"
            ]
          },
          "code": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "slugs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "setting": {
      "enum": [
        "dragonlance",
        "forgotten_realms",
        "eberron",
        "greyhawk",
        "ravenloft",
        "mystara",
        "dark_sun",
        "spelljammer",
        "planescape",
        "birthright",
        "nerath",
        "generic",
        "multiple",
        "none"
      ]
    },
    "partialDate": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "isbn13": {
      "type": "integer",
      "minimum": 9780000000000,
      "maximum": 9799999999999
    },
    "cover": {
      "type": "string",
      "pattern": "^/images/comics/[a-z0-9-]+/[a-z0-9-]+\\.webp$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number"
      ],
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/partialDate"
        },
        "writers": {
          "$ref": "#/$defs/people"
        },
        "artists": {
          "$ref": "#/$defs/people"
        },
        "cover": {
          "$ref": "#/$defs/cover"
        },
        "cover_source": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "contents": {
      "description": "Qué números recoge una edición: la serie y un rango («1-5», «1-3, 6») de sus números",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "series",
          "issues"
        ],
        "properties": {
          "series": {
            "$ref": "#/$defs/slug"
          },
          "issues": {
            "type": "string",
            "pattern": "^[^,]+(, ?[^,]+)*$"
          }
        }
      }
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "publisher",
        "format"
      ],
      "properties": {
        "id": {
          "description": "Solo en collections.json: identificador del tomo de varias series",
          "$ref": "#/$defs/slug"
        },
        "language": {
          "enum": [
            "english",
            "castellano"
          ]
        },
        "spain": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/partialDate"
        },
        "format": {
          "enum": [
            "paperback",
            "hardcover",
            "omnibus",
            "digital",
            "issue"
          ]
        },
        "isbn13": {
          "$ref": "#/$defs/isbn13"
        },
        "cover": {
          "$ref": "#/$defs/cover"
        },
        "cover_source": {
          "type": "string",
          "format": "uri"
        },
        "contents": {
          "$ref": "#/$defs/contents"
        },
        "issues": {
          "description": "Solo en ediciones en grapa (format: issue): sus números, con la numeración y las fechas de esa edición",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "purchase_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/purchaseLink"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "language": {
                "const": "castellano"
              }
            }
          },
          "then": {
            "required": [
              "spain"
            ]
          },
          "else": {
            "not": {
              "required": [
                "spain"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "issue"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "required": [
              "issues"
            ]
          },
          "else": {
            "required": [
              "contents"
            ],
            "not": {
              "required": [
                "issues"
              ]
            }
          }
        }
      ]
    },
    "purchaseLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "url"
      ],
      "properties": {
        "store": {
          "enum": [
            "amazon",
            "generacion_x",
            "casa_del_libro"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
