{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/videogame",
    "title": "Videogame",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "slug",
        "title",
        "description",
        "developers",
        "publishers",
        "genres",
        "releases"
    ],
    "properties": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "title_es": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "developers": {
            "$ref": "#/$defs/names"
        },
        "publishers": {
            "$ref": "#/$defs/names"
        },
        "genres": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "rpg",
                    "action_rpg",
                    "tactical_rpg",
                    "action",
                    "beat_em_up",
                    "strategy",
                    "real_time_strategy",
                    "mmo",
                    "roguelike",
                    "simulation",
                    "flight_simulation",
                    "adventure",
                    "idle",
                    "board_game",
                    "card_game",
                    "management"
                ]
            }
        },
        "modes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "enum": [
                    "single",
                    "coop",
                    "multiplayer"
                ]
            }
        },
        "setting": {
            "enum": [
                "forgotten_realms",
                "dragonlance",
                "mystara",
                "dark_sun",
                "ravenloft",
                "planescape",
                "greyhawk",
                "eberron",
                "spelljammer",
                "al_qadim",
                "birthright"
            ]
        },
        "ruleset": {
            "enum": [
                "adnd1",
                "adnd2",
                "3e",
                "3_5",
                "4e",
                "5e",
                "2024",
                "own"
            ]
        },
        "series": {
            "type": "string"
        },
        "status": {
            "enum": [
                "released",
                "shut_down",
                "announced"
            ]
        },
        "expansions": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "title"
                ],
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "date": {
                        "$ref": "#/$defs/partialDate"
                    }
                }
            }
        },
        "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/release"
            }
        },
        "reviews": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/review"
            }
        },
        "images": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^/images/videogames/"
            }
        },
        "official_url": {
            "type": "string",
            "format": "uri"
        },
        "related_products": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "edition",
                    "code"
                ],
                "properties": {
                    "edition": {
                        "enum": [
                            "5e",
                            "2024"
                        ]
                    },
                    "code": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "$defs": {
        "names": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "partialDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
        },
        "platform": {
            "enum": [
                "pc_windows",
                "pc_dos",
                "mac",
                "linux",
                "amiga",
                "atari_st",
                "c64",
                "apple_ii",
                "pc98",
                "pc88",
                "x68000",
                "fm_towns",
                "msx",
                "amstrad_cpc",
                "zx_spectrum",
                "aquarius",
                "intellivision",
                "nes",
                "snes",
                "master_system",
                "genesis",
                "sega_cd",
                "saturn",
                "turbografx_16",
                "3do",
                "playstation",
                "ps2",
                "ps3",
                "ps4",
                "ps5",
                "xbox",
                "xbox_360",
                "xbox_one",
                "xbox_series",
                "gamecube",
                "wii_u",
                "switch",
                "switch_2",
                "game_boy_advance",
                "psp",
                "arcade",
                "ios",
                "android",
                "mobile_phone",
                "browser"
            ]
        },
        "release": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "platform"
            ],
            "properties": {
                "platform": {
                    "$ref": "#/$defs/platform"
                },
                "date": {
                    "$ref": "#/$defs/partialDate"
                },
                "edition": {
                    "type": "string"
                },
                "developers": {
                    "$ref": "#/$defs/names"
                },
                "publishers": {
                    "$ref": "#/$defs/names"
                },
                "spanish": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "interface",
                        "subtitles",
                        "audio"
                    ],
                    "properties": {
                        "interface": {
                            "type": "boolean"
                        },
                        "subtitles": {
                            "type": "boolean"
                        },
                        "audio": {
                            "type": "boolean"
                        },
                        "note": {
                            "type": "string"
                        }
                    }
                },
                "purchase_links": {
                    "$ref": "#/$defs/purchaseLinks"
                },
                "delisted": {
                    "type": "boolean"
                },
                "bundle": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                }
            }
        },
        "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "source",
                "score",
                "scale",
                "url"
            ],
            "properties": {
                "source": {
                    "enum": [
                        "metacritic",
                        "opencritic",
                        "meristation",
                        "vandal",
                        "3djuegos",
                        "ign",
                        "gamespot",
                        "pc_gamer",
                        "eurogamer",
                        "gamespy",
                        "computer_gaming_world"
                    ]
                },
                "score": {
                    "type": "number",
                    "minimum": 0
                },
                "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "platform": {
                    "$ref": "#/$defs/platform"
                },
                "edition": {
                    "type": "string"
                }
            }
        },
        "purchaseLinks": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "store",
                    "url"
                ],
                "properties": {
                    "store": {
                        "enum": [
                            "gog",
                            "steam",
                            "amazon",
                            "humble",
                            "fanatical",
                            "green_man_gaming",
                            "instant_gaming",
                            "eneba",
                            "epic",
                            "playstation",
                            "nintendo",
                            "xbox"
                        ]
                    },
                    "url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "format": {
                        "enum": [
                            "digital",
                            "physical"
                        ]
                    }
                }
            }
        }
    }
}
