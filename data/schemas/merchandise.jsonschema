{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/merchandise",
    "title": "Merchandise",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "slug",
        "title",
        "group",
        "kind",
        "manufacturer",
        "description",
        "source",
        "editions",
        "images"
    ],
    "properties": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "title_es": {
            "type": "string",
            "minLength": 1
        },
        "group": {
            "enum": [
                "books",
                "figures",
                "games"
            ]
        },
        "kind": {
            "enum": [
                "cookbook",
                "craft_book",
                "art_book",
                "guide_book",
                "funko",
                "lego",
                "figure",
                "plush",
                "collectible_miniature",
                "board_game",
                "card_game"
            ]
        },
        "manufacturer": {
            "type": "string",
            "minLength": 1
        },
        "date": {
            "$ref": "#/$defs/partialDate"
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "source": {
            "type": "string",
            "format": "uri"
        },
        "editions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/edition"
            }
        },
        "images": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "pattern": "^/images/merchandising/"
            }
        },
        "expansions": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "title"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1
                    },
                    "date": {
                        "$ref": "#/$defs/partialDate"
                    }
                }
            }
        },
        "related_products": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "edition",
                    "code"
                ],
                "properties": {
                    "edition": {
                        "enum": [
                            "5e",
                            "2024"
                        ]
                    },
                    "code": {
                        "type": "string"
                    }
                }
            }
        },
        "related_videogames": {
            "type": "array",
            "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "group": {
                        "const": "books"
                    }
                }
            },
            "then": {
                "properties": {
                    "kind": {
                        "enum": [
                            "cookbook",
                            "craft_book",
                            "art_book",
                            "guide_book"
                        ]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "group": {
                        "const": "figures"
                    }
                }
            },
            "then": {
                "properties": {
                    "kind": {
                        "enum": [
                            "funko",
                            "lego",
                            "figure",
                            "plush",
                            "collectible_miniature"
                        ]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "group": {
                        "const": "games"
                    }
                }
            },
            "then": {
                "properties": {
                    "kind": {
                        "enum": [
                            "board_game",
                            "card_game"
                        ]
                    }
                }
            }
        }
    ],
    "$defs": {
        "partialDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
        },
        "edition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "language": {
                    "enum": [
                        "english",
                        "castellano"
                    ]
                },
                "spain": {
                    "type": "boolean"
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "publisher": {
                    "type": "string",
                    "minLength": 1
                },
                "date": {
                    "$ref": "#/$defs/partialDate"
                },
                "isbn13": {
                    "type": "integer",
                    "minimum": 9780000000000,
                    "maximum": 9799999999999
                },
                "ean": {
                    "type": "string",
                    "pattern": "^\\d{8,14}$"
                },
                "purchase_links": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/purchaseLink"
                    }
                }
            },
            "if": {
                "properties": {
                    "language": {
                        "const": "castellano"
                    }
                },
                "required": [
                    "language"
                ]
            },
            "then": {
                "required": [
                    "spain"
                ]
            },
            "else": {
                "not": {
                    "required": [
                        "spain"
                    ]
                }
            }
        },
        "purchaseLink": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "store",
                "url"
            ],
            "properties": {
                "store": {
                    "enum": [
                        "amazon",
                        "generacion_x",
                        "juegos_mesa_redonda"
                    ]
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        }
    }
}
