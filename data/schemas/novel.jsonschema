{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/novel",
    "title": "Novel",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "slug",
        "title",
        "authors",
        "setting",
        "kind",
        "description",
        "source",
        "editions"
    ],
    "properties": {
        "slug": {
            "$ref": "#/$defs/slug"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "title_es": {
            "type": "string",
            "minLength": 1
        },
        "authors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "setting": {
            "$ref": "#/$defs/setting"
        },
        "kind": {
            "enum": [
                "novel",
                "young_adult",
                "middle_grade",
                "novella",
                "short_story",
                "fiction_guide"
            ]
        },
        "series": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "number"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/slug"
                },
                "number": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "date": {
            "$ref": "#/$defs/partialDate"
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "source": {
            "type": "string",
            "format": "uri"
        },
        "editions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/edition"
            },
            "contains": {
                "properties": {
                    "language": {
                        "const": "english"
                    }
                }
            }
        },
        "related_products": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "edition",
                    "code"
                ],
                "properties": {
                    "edition": {
                        "enum": [
                            "5e",
                            "2024"
                        ]
                    },
                    "code": {
                        "type": "string"
                    }
                }
            }
        },
        "related_videogames": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/slug"
            }
        },
        "related_merchandise": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/slug"
            }
        }
    },
    "$defs": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "setting": {
            "enum": [
                "dragonlance",
                "forgotten_realms",
                "eberron",
                "greyhawk",
                "ravenloft",
                "mystara",
                "dark_sun",
                "spelljammer",
                "planescape",
                "birthright",
                "nerath",
                "generic"
            ]
        },
        "partialDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
        },
        "edition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "language",
                "publisher"
            ],
            "properties": {
                "language": {
                    "enum": [
                        "english",
                        "castellano"
                    ]
                },
                "country": {
                    "enum": [
                        "us",
                        "uk",
                        "ca",
                        "au"
                    ]
                },
                "spain": {
                    "type": "boolean"
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "publisher": {
                    "type": "string",
                    "minLength": 1
                },
                "date": {
                    "$ref": "#/$defs/partialDate"
                },
                "format": {
                    "enum": [
                        "hardcover",
                        "paperback",
                        "mass_market",
                        "ebook",
                        "web"
                    ]
                },
                "isbn13": {
                    "$ref": "#/$defs/isbn13"
                },
                "cover": {
                    "$ref": "#/$defs/cover"
                },
                "source": {
                    "type": "string",
                    "format": "uri"
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                },
                "purchase_links": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/purchaseLink"
                    }
                }
            },
            "allOf": [
                {
                    "$ref": "#/$defs/languageFlags"
                },
                {
                    "if": {
                        "properties": {
                            "format": {
                                "const": "web"
                            }
                        },
                        "required": [
                            "format"
                        ]
                    },
                    "then": {
                        "required": [
                            "url"
                        ],
                        "not": {
                            "anyOf": [
                                {
                                    "required": [
                                        "isbn13"
                                    ]
                                },
                                {
                                    "required": [
                                        "purchase_links"
                                    ]
                                }
                            ]
                        }
                    },
                    "else": {
                        "not": {
                            "required": [
                                "url"
                            ]
                        }
                    }
                }
            ]
        },
        "languageFlags": {
            "if": {
                "properties": {
                    "language": {
                        "const": "castellano"
                    }
                }
            },
            "then": {
                "required": [
                    "spain"
                ],
                "not": {
                    "required": [
                        "country"
                    ]
                }
            },
            "else": {
                "required": [
                    "country"
                ],
                "not": {
                    "required": [
                        "spain"
                    ]
                }
            }
        },
        "isbn13": {
            "type": "integer",
            "minimum": 9780000000000,
            "maximum": 9799999999999
        },
        "cover": {
            "type": "string",
            "pattern": "^/images/novels/[a-z0-9-]+/[a-z0-9-]+\\.webp$"
        },
        "purchaseLink": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "store",
                "url"
            ],
            "properties": {
                "store": {
                    "enum": [
                        "amazon",
                        "generacion_x",
                        "juegos_mesa_redonda",
                        "casa_del_libro"
                    ]
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        }
    }
}
