{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/rpg-book",
    "title": "RPG book",
    "description": "Libro de la sección de otros juegos de rol, con sus ediciones en inglés y en castellano",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "slug",
        "system",
        "title",
        "kind",
        "description",
        "source",
        "editions"
    ],
    "properties": {
        "slug": {
            "$ref": "#/$defs/slug"
        },
        "system": {
            "$ref": "#/$defs/slug"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "title_es": {
            "type": "string",
            "minLength": 1
        },
        "kind": {
            "enum": [
                "core",
                "starter",
                "supplement",
                "adventure",
                "setting",
                "other"
            ]
        },
        "settings": {
            "description": "Mundos de D&D en los que transcurre o que describe (mismos identificadores que novelas y videojuegos)",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "enum": [
                    "forgotten_realms",
                    "dragonlance",
                    "greyhawk",
                    "ravenloft",
                    "eberron",
                    "spelljammer",
                    "planescape",
                    "dark_sun",
                    "mystara",
                    "birthright",
                    "al_qadim",
                    "kara_tur",
                    "lankhmar",
                    "nerath",
                    "exandria",
                    "ravnica",
                    "theros",
                    "strixhaven"
                ]
            }
        },
        "core": {
            "description": "Libro principal (básico o caja de inicio) de un sistema grande; necesario para los libros solo en inglés que no son de una editorial destacada",
            "type": "boolean"
        },
        "license": {
            "description": "Solo si no usa las licencias de su sistema: otra licencia, o «none» si solo se declara compatible",
            "type": "string",
            "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)$"
        },
        "description": {
            "description": "Descripción propia en castellano: qué trae y para quién es",
            "type": "string",
            "minLength": 1
        },
        "source": {
            "type": "string",
            "format": "uri"
        },
        "editions": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/edition"
            }
        }
    },
    "$defs": {
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "partialDate": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
        },
        "edition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "language",
                "publisher"
            ],
            "properties": {
                "language": {
                    "enum": [
                        "english",
                        "castellano"
                    ]
                },
                "title": {
                    "description": "Solo si cambia respecto al título original",
                    "type": "string",
                    "minLength": 1
                },
                "publisher": {
                    "type": "string",
                    "minLength": 1
                },
                "date": {
                    "$ref": "#/$defs/partialDate"
                },
                "format": {
                    "enum": [
                        "hardcover",
                        "paperback",
                        "boxed_set",
                        "screen",
                        "pdf"
                    ]
                },
                "isbn13": {
                    "type": "integer",
                    "minimum": 9780000000000,
                    "maximum": 9799999999999
                },
                "cover": {
                    "type": "string",
                    "pattern": "^/images/rol/[a-z0-9-]+/[a-z0-9-]+\\.webp$"
                },
                "source": {
                    "type": "string",
                    "format": "uri"
                },
                "free_download": {
                    "description": "Copia gratuita liberada por la propia editorial (por ahora, solo Codex de la Marca); no es una tienda",
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://codexdelamarca\\.com/posts/[^/]+/$"
                },
                "purchase_links": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/purchaseLink"
                    }
                }
            }
        },
        "purchaseLink": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "store",
                "url"
            ],
            "properties": {
                "store": {
                    "enum": [
                        "amazon",
                        "juegos_mesa_redonda",
                        "casa_del_libro",
                        "nosolorol",
                        "dmsguild",
                        "drivethrurpg"
                    ]
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            }
        }
    }
}
