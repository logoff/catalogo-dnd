{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/review",
    "title": "Review",
    "description": "Reseña de un medio de data/review-outlets.json. El resumen es propio y en castellano; la nota, si la hay, en la escala del medio.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "outlet": {
            "type": "string"
        },
        "url": {
            "type": "string",
            "format": "uri"
        },
        "language": {
            "type": "string",
            "enum": [
                "english",
                "castellano"
            ]
        },
        "date": {
            "type": "string",
            "format": "date"
        },
        "author": {
            "type": "string"
        },
        "score": {
            "type": "number",
            "minimum": 0
        },
        "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
        },
        "spanish_edition": {
            "description": "La reseña valora la edición en castellano o su traducción",
            "const": true
        }
    },
    "required": [
        "outlet",
        "url",
        "language",
        "date",
        "summary"
    ]
}
