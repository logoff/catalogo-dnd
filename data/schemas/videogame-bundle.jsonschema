{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/schemas/videogame-bundle",
    "title": "VideogameBundle",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "title",
        "games",
        "releases"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "games": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
                "type": "string"
            }
        },
        "releases": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "platform"
                ],
                "properties": {
                    "platform": {
                        "$ref": "/schemas/videogame#/$defs/platform"
                    },
                    "date": {
                        "$ref": "/schemas/videogame#/$defs/partialDate"
                    },
                    "publishers": {
                        "$ref": "/schemas/videogame#/$defs/names"
                    },
                    "purchase_links": {
                        "$ref": "/schemas/videogame#/$defs/purchaseLinks"
                    },
                    "delisted": {
                        "type": "boolean"
                    }
                }
            }
        }
    }
}
